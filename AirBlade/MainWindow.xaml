<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AirBlade.MainWindow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AirBlade">

    <Grid x:Name="RootLayout" DataContext="{Binding ViewModel, ElementName=Root}" Padding="4" RowSpacing="1" MinWidth="320" MinHeight="140" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Height="28" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MoreButton" Grid.Column="0" Click="MoreButton_Click" Background="Transparent" BorderThickness="0" Padding="6,0" MinWidth="0" ToolTipService.ToolTip="更多设置">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE700;" FontSize="14" />
            </Button>
            <TextBlock Grid.Column="1" Padding="5" Text="AirBlade" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
            <Button x:Name="MinimizeButton" Grid.Column="2" Click="MinimizeButton_Click" Background="Transparent" BorderThickness="0" Padding="6,0" MinWidth="0" ToolTipService.ToolTip="最小化">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE921;" FontSize="14" />
            </Button>
        </Grid>
        <!-- 底部不留内边距：最后一张设备卡片的 Margin 4 就是下方间隙，与左右 4 相等。 -->
        <Border Grid.Row="1" Padding="4,4,4,0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
            <Grid>
                <ListView ItemsSource="{Binding Devices}" SelectionMode="None" IsItemClickEnabled="False" FontSize="12" Padding="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4" Margin="0,0,0,4" HorizontalAlignment="Stretch" Background="{ThemeResource AirBladeCardBackgroundBrush}" BorderBrush="{ThemeResource AirBladeCardStrokeBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="116" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="8,5" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="{Binding ConnectionStatusText}" Opacity="0.72" FontSize="11" />
                                    </Grid>
                                </Border>
                                <Slider
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="1"
                                    TickPlacement="None"
                                    IsEnabled="{Binding CanAdjustVolume}"
                                    Value="{Binding EditableVolume, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    ValueChanged="VolumeSlider_ValueChanged"
                                    PointerPressed="VolumeSlider_PointerPressed"
                                    PointerCaptureLost="VolumeSlider_PointerCaptureLost" />
                                <Button Grid.Column="2" Width="42" Height="42" Click="ToggleConnectionButton_Click" ToolTipService.ToolTip="{Binding ActionToolTip}">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{Binding ActionGlyph}" />
                                </Button>
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="{Binding EmptyStateText}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
