<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AirBlade</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <!-- 项目只支持 x64：命令行 dotnet publish 默认会按 AnyCPU 生成 PRI，
         导致资源索引与 .xbf 不匹配、发布版窗口无法显示，这里强制默认 x64。 -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- 版本号 -->
    <Version>0.5.0-beta</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>

	<!-- 强制指定为未打包模式 -->
	<WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 显式把 XAML 编译器生成的 .xbf 加入发布列表：
         缺失时构建输出有 .xbf，但 dotnet publish 的发布列表不含它们，
         导致发布版窗口创建后无法加载 XAML 内容而不可见。 -->
    <None Include="$(IntermediateOutputPath)App.xbf" Link="App.xbf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="$(IntermediateOutputPath)MainWindow.xbf" Link="MainWindow.xbf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="$(IntermediateOutputPath)SettingsWindow.xbf" Link="SettingsWindow.xbf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="$(IntermediateOutputPath)Controls\SettingItemCard.xbf" Link="Controls\SettingItemCard.xbf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Content Include="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\THIRD-PARTY-LICENSES.txt" Link="THIRD-PARTY-LICENSES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <!--
      WinUI 3 应用不能开剪裁（PublishTrimmed）和 ReadyToRun：
      剪裁会移除 XAML/WinRT 投影所需的反射元数据导致启动崩溃（0xc000027b），
      ReadyToRun 生成的 R2R 文件与增量发布的 IL 产物混用会引发类型加载异常。
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <!-- 自动将 Rust 编译出的 x64 DLL 复制到输出目录。 -->
  <ItemGroup>
	<None Include="..\airplay_core\target\debug\airplay_core.dll" Link="airplay_core.dll" Condition="'$(Configuration)' == 'Debug'">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
	<None Include="..\airplay_core\target\release\airplay_core.dll" Link="airplay_core.dll" Condition="'$(Configuration)' == 'Release'">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
  </ItemGroup>

  <Target Name="VerifyAirplayCoreDll" BeforeTargets="Build">
    <Error Condition="'$(Configuration)' == 'Debug' And !Exists('..\airplay_core\target\debug\airplay_core.dll')"
           Text="缺少 airplay_core.dll。请在 airplay_core 目录执行 cargo build。" />
    <Error Condition="'$(Configuration)' == 'Release' And !Exists('..\airplay_core\target\release\airplay_core.dll')"
           Text="缺少 airplay_core.dll。请在 airplay_core 目录执行 cargo build --release。" />
  </Target>
</Project>
