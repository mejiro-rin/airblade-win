<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AirBlade.Controls.SettingItemCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 统一设置项卡片：左侧标题与描述，右侧操作区，颜色与设备卡片一致。 -->
    <Border
        Background="{ThemeResource SettingsCardBackgroundBrush}"
        BorderBrush="{ThemeResource SettingsCardStrokeBrush}"
        BorderThickness="1"
        CornerRadius="6"
        Padding="16,12">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Header, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Description, Mode=OneWay}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <!-- 操作区整块强制靠右，内容在区域内也右对齐。 -->
            <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ContentPresenter
                    Content="{x:Bind ActionContent, Mode=OneWay}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
